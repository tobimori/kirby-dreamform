{
	"name": "tobimori/kirby-dreamform",
	"description": "Kirby DreamForm is an opiniated form builder plugin for Kirby CMS 6+ that makes forms work like magic",
	"type": "kirby-plugin",
	"license": "proprietary",
	"homepage": "https://plugins.andkindness.com/dreamform",
	"version": "3.0.0-beta.1",
	"authors": [
		{
			"name": "Tobias Möritz",
			"email": "tobias@moeritz.io"
		}
	],
	"autoload": {
		"psr-4": {
			"tobimori\\DreamForm\\": "classes"
		}
	},
	"minimum-stability": "RC",
	"require": {
		"php": "~8.3.0 || ~8.4.0 || ~8.5.0 || ~8.6.0",
		"getkirby/composer-installer": "^1.2.1"
	},
	"scripts": {
		"dist": "composer install --no-dev --optimize-autoloader",
		"fix": "@cs:fix",
		"analyze": "psalm --show-info=false",
		"cs:fix": "php-cs-fixer fix",
		"cs:check": "php-cs-fixer fix --dry-run --diff --verbose"
	},
	"config": {
		"optimize-autoloader": true,
		"allow-plugins": {
			"getkirby/composer-installer": true
		}
	},
	"extra": {
		"kirby-cms-path": false,
		"kirby": {
			"compatible": "^6.0"
		}
	},
	"require-dev": {
		"friendsofphp/php-cs-fixer": "^3.95",
		"getkirby/cms": "^6.0",
		"vimeo/psalm": "6.16.1"
	}
}
